@echo off
setlocal DisableDelayedExpansion
pushd "%~dp0"
if errorlevel 1 exit /b 1
set "JAVA_CMD=java.exe"
if defined JAVA_HOME set "JAVA_CMD=%JAVA_HOME%\bin\java.exe"
"%JAVA_CMD%" -cp "runtime\classes;runtime\lib\*" com.inzent.apim.utilities.hazelcastmonitoring.MonitorApplication "--spring.config.location=classpath:/application.yml,file:./application.yml" "--@MODE@" %*
set "LAUNCH_EXIT=%errorlevel%"
popd
exit /b %LAUNCH_EXIT%
